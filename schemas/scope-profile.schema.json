{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcarousel.com/schemas/scope-profile.schema.json",
  "title": "AgentCarousel agent-under-test scope profile",
  "description": "What an evaluation covers. Lives next to a fixture as scope.yaml; exported into evidence bundles as scope.json.",
  "type": "object",
  "required": ["schema_version", "skill_or_agent"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "skill_or_agent": { "type": "string", "minLength": 1 },
    "use_cases": { "type": "array", "items": { "type": "string" } },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "access"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "access": { "type": "string", "enum": ["read", "write"] },
          "description": { "type": "string" }
        }
      }
    },
    "modalities": { "type": "array", "items": { "type": "string" } },
    "data_sensitivity": { "type": "array", "items": { "type": "string" } },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "vulnerable": { "type": "boolean" }
        }
      }
    },
    "instance_under_test": {
      "type": "object",
      "required": ["environment", "matches_production", "data"],
      "additionalProperties": false,
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "matches_production": { "type": "boolean" },
        "guardrails": { "type": "string" },
        "data": { "type": "string", "enum": ["synthetic", "seeded", "real"] },
        "notes": { "type": "string" }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "reason"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risk_distribution": {
      "description": "Planned split of test effort; share_pct values sum to 100 (checked by agc scope check).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "share_pct", "rationale"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "share_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "rationale": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tool_calls_observed": {
      "description": "agc does not yet observe the agent's real tool calls, so this must be false.",
      "const": false
    }
  }
}
